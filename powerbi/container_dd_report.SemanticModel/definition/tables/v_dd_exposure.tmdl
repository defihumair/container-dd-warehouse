table v_dd_exposure
	lineageTag: 3d25e08c-8a4c-4cb3-99e6-f2e03349b1ce

	measure 'Total D&D USD' = SUM ( v_dd_exposure[charge_usd] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 0ee522b5-5d67-4f2f-a7f0-da831c05e058

	measure 'Demurrage USD' = ```
			CALCULATE ( [Total D&D USD], v_dd_exposure[charge_type] = "DEMURRAGE" )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 4b51e843-f1d4-426f-882e-4c7136fc36cc

	measure 'Detention USD' = ```
			CALCULATE ( [Total D&D USD], v_dd_exposure[charge_type] = "DETENTION" )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 4cbcc882-b383-471b-97b7-4e4e392c3678

	measure 'Open Exposure USD' = ```
			CALCULATE ( [Total D&D USD], v_dd_exposure[is_open] = 1 )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 6a4da46d-4684-47ad-8143-45f9b695bc64

	measure 'Charge Cycles' = ```
			COUNTROWS ( v_dd_exposure )
			
			```
		formatString: 0
		lineageTag: 3ab71bdf-ccb5-44b0-afef-c5543c30074b

	measure 'Cycles Over Free Time' = ```
			CALCULATE ( [Charge Cycles], v_dd_exposure[over_free_time] = 1 )
			
			```
		formatString: 0
		lineageTag: c0b77e9e-bf45-460a-817a-45db8d07587c

	measure '% Over Free Time' = ```
			DIVIDE ( [Cycles Over Free Time], [Charge Cycles] )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 47af753a-6685-4199-a990-55f90a393e64

	measure 'Avg Detention Days (Closed)' =
			
			CALCULATE (
			    AVERAGE ( v_dd_exposure[charge_days] ),
			    v_dd_exposure[charge_type] = "DETENTION",
			    v_dd_exposure[is_open] = 0
			)
		formatString: 0.00
		lineageTag: c8eb53a8-1a19-4508-9da4-f30d04204a77

	measure 'Previous Month USD' = ```
			CALCULATE ( [Total D&D USD], DATEADD ( v_date[full_date], -1, MONTH ) )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d1791b5f-0ee6-42af-94b7-966991c48a4f

	measure 'MoM Change %' = ```
			DIVIDE ( [Total D&D USD] - [Previous Month USD], [Previous Month USD] )
			
			```
		lineageTag: b78cd307-49f9-47a6-bc6a-4b235e25bd44

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error Checks Failed' =
			
			COALESCE ( CALCULATE ( COUNTROWS ( v_dq_summary ), v_dq_summary[severity] = "error", v_dq_summary[status] = "fail" ), 0 )
		formatString: 0
		lineageTag: 36c82416-c5af-4306-8d5f-043fc1d34dd7

	measure 'Warning Checks Failed' =
			
			COALESCE ( CALCULATE ( COUNTROWS ( v_dq_summary ), v_dq_summary[severity] = "warning", v_dq_summary[status] = "fail" ), 0 )
		formatString: 0
		lineageTag: 5e7ff15f-3881-4c49-8d1a-488590756399

	measure 'Quarantined Cycles' = ```
			SUM ( v_quarantine_summary[cycles] )
			
			```
		formatString: 0.0
		lineageTag: 6c94c85f-6d91-46e3-be6a-69f24b7a4e84

	measure 'Detention Cycles (Closed)' =
			
			CALCULATE ( [Charge Cycles], v_dd_exposure[charge_type] = "DETENTION", v_dd_exposure[is_open] = 0 )
		formatString: 0
		lineageTag: 0c3039ca-9695-4957-9774-27ac3336b640

